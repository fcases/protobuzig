{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "zig",
            "args":[
                "build",
                "-freference-trace=10",
                // "-fllvm",
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
        },
        {
            "label": "build test",
            "type": "shell",
            "command": "zig",
            "args": [
                "build-exe",
                "example/testo_main.zig",
                "-femit-bin=zig-out/bin/testo",
                "-fllvm",
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "dependsOn": [
                "Copy encdec"
            ]
        },
        {
            "label": "Copy encdec",
            "type": "shell",
            "command": "cp",
            "args": [
                "${workspaceFolder}/src/encdec.zig",
                "${workspaceFolder}/example/generated/encdec.zig",
            ],
            "problemMatcher": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
        },
    ]
}
